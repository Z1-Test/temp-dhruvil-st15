{
  "name": "universal-calculator",
  "version": "1.0.0",
  "description": "High-precision accessible calculator with zero external runtime dependencies",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:a11y": "node --experimental-strip-types --test tests/a11y/*.test.ts"
  },
  "keywords": [
    "calculator",
    "arbitrary-precision",
    "web-components",
    "accessibility"
  ],
  "author": "Autonomous Software Factory",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.8.0",
    "vite": "^8.3.3"
  }
}
